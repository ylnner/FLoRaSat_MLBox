-# Load control experiments for the LatinIoT 2027 paper.
-#
-# Physical scenario copied from Test_MLModel_8.ini (the deployed Transformer, with cold start).
-# Run from this folder. Arms:
-#   A0_Blind      blind repetition, the LATINCOM baseline
-#   A1_Mask       no transmission below the elevation mask
-#   A2_Thin       open-loop random thinning at fixed u: the throughput curve and the random-thinning
-#                 control that PAPER.md N5 asked for
-#   A2_Random     closed loop, broadcast u, device draws a coin (access barring)
-#   A3_Skip       trajectory skip (Alvarez 2022) adapted to this MAC: mask plus a sigmoid in the
-#                 beaconed device count, suppressing a repetition, SF kept fixed. pSkip is swept
-#                 because the paper fits it per scenario; N is the true above-mask demand per window,
-#                 the strongest setting for this baseline
-#   A4_FixedTau   Transformer with a fixed threshold, as published
-#   A5_Elevation  closed loop, device spends u on its highest elevations
-#   A6_Score      closed loop, device spends u on its best Transformer scores
-#
-# Targets bracket the A2_Thin and S2_Thin peaks, which sit near 20 bursts per 10 s window at every size.
-# Regenerate inputs with devices/make_load_devices.py and Files_of_ml_models/scripts/make_gate_tables.py.
-
-[General]
-network = Florasat.Test_Individual.Florasat_Individual_Sats
-
-rng-class = "cMersenneTwister"
-
-
-
-sim-time-limit 		= 749s #50s # 
-simtime-resolution 	= -11
-
-# Initial parameters, they are overwritten running throug sh file
-**.stats_altitude = 670 
-**.stats_raan = 185
-
-# Medium 
-*.radioMedium.backgroundNoise.power 					= -110dBm # Original value -96.616dBm
-*.radioMedium.mediumLimitCache.centerFrequency 			= 868MHz #Original Value Nan
-*.radioMedium.mediumLimitCache.maxTransmissionDuration 	= 4s #original value 0.01s
-*.radioMedium.mediumLimitCache.minInterferenceTime 		= 0s
-
-# Satellites
-**.numSatellites = 1
-
-*.satellite[*].mobilityType 	= "Sat_Mob_SatelliteMobility_Standalone"
-*.satellite[*].noradModuleType 	= "Sat_Mob_NoradA"
-
-**.satellite[*].**.initFromDisplayString = false
-*.satellite[*].mobility.faceForward 	 = true#false
-*.satellite[*].mobility.updateInterval 	 = 20s # disable self-message update mechanism
-
-*.satellite[*].NoradModule.satName  = "FLoRaSat"
-*.satellite[*].NoradModule.satIndex = -1
-*.satellite[*].NoradModule.baseYear = 20
-*.satellite[*].NoradModule.baseDay  = 1.5
-
-*.satellite[*].NoradModule.planes 		= 1
-*.satellite[*].NoradModule.satPerPlane  = 1
-*.satellite[*].NoradModule.eccentricity = 0.000001
-*.satellite[*].NoradModule.inclination 	= 98
-*.satellite[*].NoradModule.altitude 	= 670 # 660  
-
-# Single pass satellite
-# Uncomment these line to execute with several raan. This is executed by sh file.
-#*.satellite[0].NoradModule.raan 		= ${165, 175, 185, 195, 205}
-*.satellite[0].NoradModule.raan = ${myraan = 165, 175, 185, 195, 205}  #185
-*.satellite[0].NoradModule.meanAnomaly  = 195#205 
-
-
-#### Detecta Doppler
-*.satellite[*].phyDSL.radio.receiver.enableCollisionOverlap = true
-*.satellite[*].phyDSL.radio.receiver.minCollisionOverlap = 0s
-
-# Set antenna mobility modules for satellite radios
-*.satellite[*].phyDSL.radio.antenna.typename 		= "ConstantGainAntenna"
-*.satellite[*].phyDSL.radio.antenna.mobilityModule  = "^.^.^.mobility"
-*.satellite[*].phyISL.radio.antenna.mobilityModule  = "^.^.^.mobility"
-*.satellite[*].phyGSL.radio.antenna.mobilityModule  = "^.^.^.mobility"
-
-# Set antenna gain for radio 
-*.satellite[*].phyDSL.radio.antenna.gain = 12dB
-
-*.satellite[*].net.routingType = "Null_Routing" #"Base_Routing"
-*.terminal[*].net.routingType  = "Ter_Null_Routing" #"Base_Routing"
-
-*.**.numGroundLinks 					  = 40
-*.satellite[*].**.interfaceTableModule    = ""
-
-# LoRa PHY Configuration
-**.radioMedium.typename 			= "LoRaMedium"
-**.radioMedium.analogModel.typename = "LoRaAnalogModel"
-							   
-# Disable ISLs
-**.intraPlaneIslDisabled = false
-**.interPlaneIslDisabled = false
-
-# LoRa Nodes (devices on ground)
-
-
-*.terminal[*].phy.radio.antenna.mobilityModule 	= "^.^.^.mob"
-*.terminal[*].dlk.mac.interfaceTableModule 		= ""
-*.terminal[*].dlk.energySourceModule 			= ""
-
-# Toda la informacion de LoraPhyPreamble se jala desde MacFrame
-# El lora TP esta en dBm aunque no tiene unidad
-*.terminal[*].dlk.mac.LoRaTP = intuniform(12, 14) #* 1dBm  #14
-*.terminal[*].dlk.mac.LoRaSF = intuniform(10, 12) #11
-
-
-
-
-# Application
-**.numberOfPacketsToSend = 0  	#${numberOfPAckets = 200..5000 step 200}  # 0 means infinite number of packets
-**.timeToFirstPacket 	 = 1s   #time to first packet can be set at any moment
-**.timeToNextPacket 	 = 115s #50s	#time to next packet must follow the 1% duty cycle, you can find the limit time on SimpleLoRaApp
-
-
-# Stations
-**.numStations = 3
-include stations/WorldWide-20.ini
-
-# Visualizer
-# Disable medium visualizer completely
-*.visualizer.canvasVisualizer.mediumVisualizer.typename = ""
-*.visualizer.*.radioVisualizer.displayAntennaLobes = true
-*.visualizer.*.dataLinkVisualizer.displayLinks = true
-*.visualizer.*.mobilityVisualizer.displayMovementTrails = true
-*.visualizer.*.mobilityVisualizer.movementTrailLineWidth = 1
-*.visualizer.*.mobilityVisualizer.trailLength = 3000
-
-
-# Mac parameters
-**.ttxStart_max = 1s
-**.ttxIdle_min = 10s                            # Minimum idle time between transmissions
-**.ttxIdle_max = 15s                           	# Maximum idle time between transmissions
-**.Ntw = 1										# Number of transmission windows
-**.Ntx = 5										# Number of transmission windows
-**.ttwDuration = 100s                           # Duration of the transmission window
-
-
-
-#####################
-# Load control
-#####################
-repeat = 10
-seed-0-mt = ${23542, 84242, 15937, 42781, 63029, 88143, 27456, 51904, 76328, 92115 ! repetition}
-num-rngs = 2
-seed-1-mt = ${13541, 74243, 25938, 32782, 53030, 78144, 37457, 41905, 66329, 82116 ! repetition}
-**.gateRng = 1
-
-**.numTerminals = ${numDev = 60, 120, 240, 480, 960}
-include devices/WorldWide-960_closed_loop_load.ini
-
-*.loadBroadcast.enabled = true
-*.loadBroadcast.window = 10s
-*.terminal[*].dlk.mac.gateMaskDeg = 10
-*.terminal[*].dlk.mac.mlBox.modelPath = "mlmodels/transformer_scripted.pt"
-*.terminal[*].dlk.mac.mlBox.coldStart = true
-*.terminal[*].dlk.mac.mlBox.threshold = 0.5
-
-# As in Test_MLModel_8.ini. Some NED statistics record a Packet signal as a vector, which stops the
-# run at the first reception. recordScalar and cOutVector do not go through these modes.
-**.result-recording-modes = -
-
-# Parameters are most of a .sca file, and 9000 runs of them would pass the Grid'5000 quota.
-**.param-recording = false
-
-# Vectors are what made this repo 22 GB: keep only what the KPIs read. Delivered messages are a
-# scalar at the satellite, so they do not depend on this filter.
-**.scalar-recording = true
-*.loadBroadcast.**.vector-recording = true
-**.*Message Generation Delay at Satellite.vector-recording = true
-**.vector-recording = false
-**.vector-record-eventnumbers = false
-
-output-scalar-file = results/lc/${configname}-n${numDev}-raan${myraan}-${iterationvarsf}-r${repetition}.sca
-output-vector-file = results/lc/${configname}-n${numDev}-raan${myraan}-${iterationvarsf}-r${repetition}.vec
-
-[Config A0_Blind]
-*.terminal[*].dlk.mac.gateMode = "none"
-
-[Config A1_Mask]
-*.terminal[*].dlk.mac.gateMode = "mask"
-
-[Config A2_Thin]
-*.terminal[*].dlk.mac.gateMode = "random"
-*.loadBroadcast.fixedU = ${fixedU = 1, 0.8, 0.6, 0.4, 0.3, 0.2, 0.1, 0.05, 0.025, 0.0125}
-
-[Config A2_Random]
-*.terminal[*].dlk.mac.gateMode = "random"
-*.loadBroadcast.targetBursts = ${target = 10, 15, 20, 30}
-
-[Config A3_Skip]
-*.terminal[*].dlk.mac.gateMode = "skip"
-*.terminal[*].dlk.mac.gateSkipParam = ${pSkip = 30, 60, 120, 240, 480, 960}
-
-[Config A4_FixedTau]
-*.terminal[*].dlk.mac.useMLBox = true
-*.terminal[*].dlk.mac.gateMode = "none"
-
-[Config A5_Elevation]
-*.terminal[*].dlk.mac.gateMode = "elevation"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_elevation.csv"
-*.terminal[*].dlk.mac.gateSoftness = 3
-*.loadBroadcast.targetBursts = ${target = 10, 15, 20, 30}
-
-[Config A6_Score]
-*.terminal[*].dlk.mac.useMLBox = true
-*.terminal[*].dlk.mac.gateMode = "score"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_transformer.csv"
-*.terminal[*].dlk.mac.gateSoftness = 0.25
-*.loadBroadcast.targetBursts = ${target = 10, 15, 20, 30}
-
-# Fleet share that never hears the broadcast
-[Config A2_Uncontrolled]
-extends = A2_Random
-*.terminal[*].dlk.mac.uncontrolledFraction = ${f = 0.25, 0.5, 0.75}
-
-[Config A6_Uncontrolled]
-extends = A6_Score
-*.terminal[*].dlk.mac.uncontrolledFraction = ${f = 0.25, 0.5, 0.75}
-
-# Broadcast budget: bits per update and update period
-[Config A6_Budget]
-extends = A6_Score
-*.loadBroadcast.bits = ${bits = 1, 2, 4, 8}
-*.loadBroadcast.window = ${updateS = 10, 30, 60}s
-
-# Staggered traffic. In the arms above every device starts within the same second and repeats every
-# 115 s, as in Test_MLModel_8.ini, so load arrives in waves with silence between them. Here each device
-# keeps the 115 s period from its own random offset, which gives steady load. These configs are
-# appended on purpose: workers re-read this file at every launch, so existing run numbers must not move.
-[Config S0_Blind]
-extends = A0_Blind
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S1_Mask]
-extends = A1_Mask
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S2_Thin]
-extends = A2_Thin
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S2_Random]
-extends = A2_Random
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S3_Skip]
-extends = A3_Skip
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S4_FixedTau]
-extends = A4_FixedTau
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S5_Elevation]
-extends = A5_Elevation
-**.timeToFirstPacket = uniform(1s, 115s)
-
-[Config S6_Score]
-extends = A6_Score
-**.timeToFirstPacket = uniform(1s, 115s)
-
-# Selection arms with targets above the range bracketing the random peak: at targets 10 to 30 both
-# kept improving up to the top value, so their own peak was not reached.
-[Config S5_Wide]
-**.timeToFirstPacket = uniform(1s, 115s)
-*.terminal[*].dlk.mac.gateMode = "elevation"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_elevation.csv"
-*.terminal[*].dlk.mac.gateSoftness = 3
-*.loadBroadcast.targetBursts = ${target = 40, 60, 80, 120}
-
-[Config S6_Wide]
