-*.terminal[*].dlk.mac.gateMode = "score"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_transformer.csv"
-*.terminal[*].dlk.mac.gateSoftness = 0.25
-*.loadBroadcast.targetBursts = ${target = 40, 60, 80, 120}
-
-# Repetition budget per message. A rank gate passes all of a message's repetitions or none, which
-# wastes bursts on messages already through. cap = -1 sends at most ceil(Ntx * u), cap = 1 only one.
-[Config S2_Cap]
-**.timeToFirstPacket = uniform(1s, 115s)
-*.terminal[*].dlk.mac.gateMode = "random"
-*.terminal[*].dlk.mac.gateRepCap = ${cap = -1, 1}
-*.loadBroadcast.targetBursts = ${target = 20, 30, 40, 60}
-
-[Config S5_Cap]
-**.timeToFirstPacket = uniform(1s, 115s)
-*.terminal[*].dlk.mac.gateMode = "elevation"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_elevation.csv"
-*.terminal[*].dlk.mac.gateSoftness = 3
-*.terminal[*].dlk.mac.gateRepCap = ${cap = -1, 1}
-*.loadBroadcast.targetBursts = ${target = 20, 30, 40, 60}
-
-[Config S6_Cap]
-**.timeToFirstPacket = uniform(1s, 115s)
-*.terminal[*].dlk.mac.useMLBox = true
-*.terminal[*].dlk.mac.gateMode = "score"
-*.terminal[*].dlk.mac.gateTable = "gate/tau_transformer.csv"
-*.terminal[*].dlk.mac.gateSoftness = 0.25
-*.terminal[*].dlk.mac.gateRepCap = ${cap = -1, 1}
-*.loadBroadcast.targetBursts = ${target = 20, 30, 40, 60}
-
-# The budget without the controller: fixedU = 1 is the budget alone, and the rest give the best a
-# tuned fixed u can do, so the loop's own contribution can be isolated.
